// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  customer_id String?  @unique
  city        String
  street      String
  phone       String
  photo       String?
  secret      String?
  isTwoFA     Boolean  @default(false)
  BackupCodes String[]
  isConfirmed Boolean  @default(false)
  role        Role?    @default(User)
  date_birth  DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  reviews   review[]
  payments  payment[]
  bookings  booking[]
  favorites favorite[]
}

model review {
  id      Int    @id @default(autoincrement())
  user    user   @relation(fields: [userId], references: [id])
  userId  Int
  hotel   hotel  @relation(fields: [hotelId], references: [id])
  hotelId Int
  rating  Int
  comment String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model payment {
  id        Int           @id @default(autoincrement())
  user      user          @relation(fields: [userId], references: [id])
  userId    Int
  amount    Float
  paymentId String        @unique
  paidAt    DateTime?
  status    paymentStatus @default(pending)
  booking   booking       @relation(fields: [bookingId], references: [id])
  bookingId Int           @unique
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())
}

model booking {
  id             Int           @id @default(autoincrement())
  user           user          @relation(fields: [userId], references: [id])
  userId         Int
  room           room          @relation(fields: [roomCode], references: [code])
  roomCode       String
  booking_status BookingStatus @default(PENDING)
  check_in       DateTime
  check_out      DateTime
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  payment        payment?

  @@unique([check_in, check_out, roomCode])
}

model favorite {
  id        Int      @id @default(autoincrement())
  user      user     @relation(fields: [userId], references: [id])
  userId    Int
  hotel     hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model hotel {
  id              Int         @id @default(autoincrement())
  code            Int         @unique
  name            String
  description     String
  address         String
  email           String?
  phone           String[]
  images          String[]
  facilities      String[]
  web             String
  ranking         Int
  rating          Int
  latitude        Float?
  longitude       Float?
  destinationCode String
  destination     destination @relation(fields: [destinationCode], references: [code])
  city            String
  countryCode     String
  updatedAt       DateTime    @updatedAt
  createdAt       DateTime    @default(now())
  favorites       favorite[]
  reviews         review[]
  rooms           room[]

  @@index([createdAt])
}

model room {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  hotelCode    Int
  hotel        hotel     @relation(fields: [hotelCode], references: [code])
  maxAudits    Int
  maxChildren  Int
  description  String?
  roomType     String
  roomCategory String
  facilities   String[]
  bookings     booking[]
}
model destination {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  countryCode String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  hotels      hotel[]
}


// enums
enum Role {
  Admin
  User
  SuperAdmin
}

enum paymentStatus {
  pending
  completed
  failed
  canceled
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
