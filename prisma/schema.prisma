// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  customer_id String?  @unique
  city        String
  street      String
  phone       String
  photoUrl    String?
  photoId     String?
  secret      String?
  isTwoFA     Boolean  @default(false)
  BackupCodes String[]
  isConfirmed Boolean  @default(false)
  role        Role?    @default(User)
  date_birth  DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  reviews   review[]
  payments  payment[]
  bookings  booking[]
  favorites favorite[]
}

model review {
  id      Int    @id @default(autoincrement())
  user    user   @relation(fields: [userId], references: [id])
  userId  Int
  hotel   hotel  @relation(fields: [hotelId], references: [id])
  hotelId Int
  rating  Int
  comment String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model payment {
  id            Int           @id @default(autoincrement())
  user          user          @relation(fields: [userId], references: [id])
  userId        Int
  amount        Float
  currency      String?       @default("EGP")
  paymentId     String        @unique
  gateway         PaymentGateway 
  paidAt        DateTime?     @db.Date
  status        paymentStatus @default(pending)
  booking       booking       @relation(fields: [bookingId], references: [id])
  bookingId     Int           @unique
  failureReason String?
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())
}

model booking {
  id                    Int           @id @default(autoincrement())
  bookingNumber         String        @unique
  userId                Int
  providerReference     String?       @unique
  totalPrice            Decimal       @db.Decimal(10, 2)
  status                BookingStatus @default(PENDING)
  checkIn               DateTime      @db.Date
  checkOut              DateTime      @db.Date
  currency              String        @default("EGP")
  holderEmail           String
  holderFirstName       String
  holderLastName        String
  holderPhone           String
  refundAmount          Int?
  cancellationFees      Int?
  cancellationReference String?
  paymentType           PaymentType
  rooms                 bookingRoom[]
  payment               payment?
  user                  user          @relation(fields: [userId], references: [id])
  createdAt             DateTime      @default(now())

  @@index([checkIn, checkOut])
}

model bookingRoom {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  booking       booking  @relation(fields: [bookingId], references: [id])
  roomCode      String
  hotelId       Int
  room          room     @relation(fields: [roomCode, hotelId], references: [code, hotelId])
  guestsData    Json?
  rateKey       String
  price         Decimal  @db.Decimal(10, 2)
  adultsCount   Int
  childrenCount Int
  createdAt     DateTime @default(now())

  @@index([bookingId, roomCode, hotelId])
}

model favorite {
  id        Int      @id @default(autoincrement())
  user      user     @relation(fields: [userId], references: [id])
  userId    Int
  hotel     hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model hotel {
  id              Int               @id
  code            Int               @unique
  name            String
  description     String
  address         String
  email           String?
  images          String[]
  web             String
  ranking         Int
  rating          Int
  latitude        Float?
  longitude       Float?
  destinationCode String
  destination     destination       @relation(fields: [destinationCode], references: [code])
  city            String
  countryCode     String
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  favorites       favorite[]
  reviews         review[]
  rooms           room[]
  facilities      hotelFacilities[]
  phones          hotelPhone[]

  @@index([createdAt, id])
}

model hotelPhone {
  id          Int    @id @default(autoincrement())
  phoneNumber String
  phoneType   String
  hotelId     Int
  hotel       hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model room {
  id           Int              @id @default(autoincrement())
  code         String
  hotelId      Int
  hotel        hotel            @relation(fields: [hotelId], references: [id])
  maxAdults    Int
  maxChildren  Int
  isParentRoom Boolean?
  roomType     String
  description  String?
  roomCategory String
  facilities   roomFacilities[]
  bookingRooms bookingRoom[]
  updatedAt    DateTime         @updatedAt
  createdAt    DateTime         @default(now())

  @@unique([code, hotelId])
  @@index([hotelId, code])
}

model facility {
  id              Int               @id @default(autoincrement())
  code            Int
  groupCode       Int
  name            String
  roomFacilities  roomFacilities[]
  hotelFacilities hotelFacilities[]

  @@unique([code, groupCode])
}

model hotelFacilities {
  id                Int      @id @default(autoincrement())
  hotelId           Int
  facilityCode      Int
  facilityGroupCode Int
  order             Int?
  indFee            Boolean?
  indLogic          Boolean?
  indYesOrNo        Boolean?
  voucher           Boolean?
  timeFrom          String?
  timeTo            String?
  number            Int?
  hotel             hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  facility          facility @relation(fields: [facilityCode, facilityGroupCode], references: [code, groupCode], onDelete: Cascade)

  @@unique([hotelId, facilityCode])
}

model roomFacilities {
  id                Int      @id @default(autoincrement())
  facilityCode      Int
  facilityGroupCode Int
  indFee            Boolean?
  indLogic          Boolean?
  voucher           Boolean?
  roomCode          String
  hotelId           Int
  number            Int?
  facility          facility @relation(fields: [facilityCode, facilityGroupCode], references: [code, groupCode], onDelete: Cascade)
  room              room     @relation(fields: [roomCode, hotelId], references: [code, hotelId])

  @@unique([hotelId, roomCode, facilityCode])
}

model destination {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  countryCode String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  hotels      hotel[]
}

// enums
enum Role {
  Admin
  User
  SuperAdmin
}

enum paymentStatus {
  pending
  completed
  failed
  Refund
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentType {
  AT_WEB
  AT_HOTEL
}
enum PaymentGateway{
  stripe
}